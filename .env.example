# ---------------------------------------------------------------- model
# Pick a local runtime: ollama | lmstudio | llamacpp | vllm
# The endpoint is derived from it automatically. No cloud account required.
ATLAS_MODEL_PROVIDER=ollama

# Ollama server root (no /v1 — Atlas adds it for the OpenAI-compatible API).
# Local Ollama needs no API key; the placeholder below only satisfies the SDK.
ATLAS_OLLAMA_URL=http://127.0.0.1:11434
ATLAS_API_KEY=ollama

# Model id must already be installed on THIS machine (`ollama list`).
# Leave it UNSET to auto-detect the first installed local model — the most
# flexible choice when you sync this repo across several computers.
# Examples: 8 GB M1 -> qwen2.5:3b   |   bigger machine -> deepseek-r1:7b
# Set it explicitly only when you want to force one model everywhere:
# ATLAS_MODEL=deepseek-r1:7b

# Legacy override: an explicit OpenAI-compatible URL wins over the provider.
# ATLAS_BASE_URL=http://127.0.0.1:11434/v1

# Generation ceilings (always bounded, never infinite).
# Reasoning models (DeepSeek R1, QwQ, thinking checkpoints) get the larger
# budget automatically; normal chat models use ATLAS_MAX_TOKENS.
ATLAS_MAX_TOKENS=1024
ATLAS_REASONING_TOKENS=4096

# hybrid = keywords first, embeddings only when needed
# keyword = fastest and fully offline; semantic = best fuzzy matching
ATLAS_RETRIEVAL=hybrid

# Optional: store Markdown directly in an Obsidian vault.
# ATLAS_VAULT=/path/to/My Vault
# ATLAS_NOTES_DIR=/path/to/another/memory/folder

# Runtime chat history stays separate from the Markdown vault.
# ATLAS_DATA_DIR=/path/to/.local/share/atlas

# Embeddings for fuzzy memory recall (keyword search remains the fallback).
ATLAS_EMBED_MODEL=nomic-embed-text

# Where your projects live (activity scan reads git + file timestamps).
# ATLAS_PROJECTS=/path/to/dev

# Optional second tier: a paid model for hard questions only.
# Enable in chat with /frontier. See COSTS.md.
# ATLAS_FRONTIER_BASE_URL=https://api.deepseek.com/v1
# ATLAS_FRONTIER_API_KEY=sk-...
# ATLAS_FRONTIER_MODEL=deepseek-chat
